{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reportkit.dev/schema/report-manifest-v1.schema.json",
  "title": "ReportKit report manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion", "reportKitVersion", "schemaVersion", "template",
    "reportId", "generatedAt", "dataAsOf", "classification",
    "pageCount", "itemCount", "files", "validation"
  ],
  "properties": {
    "manifestVersion": { "const": "1.0" },
    "reportKitVersion": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["built-in", "declarative", "trusted-extension"] },
        "source": { "enum": ["repository", "project", "trusted-extension"] },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "reportId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "dataAsOf": { "type": "string", "format": "date-time" },
    "classification": { "type": "string", "minLength": 1 },
    "pageCount": { "type": "integer", "minimum": 1 },
    "itemCount": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors", "warnings", "info"],
      "properties": {
        "status": { "enum": ["passed", "passed-with-warnings", "failed"] },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
