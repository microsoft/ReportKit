{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reportkit.dev/schema/template-capability-v1.schema.json",
  "title": "ReportKit template capability contract 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "id", "version", "supportedSchemaVersions",
    "requiredSections", "requiredFields", "optionalSections",
    "supportedPageTypes"
  ],
  "anyOf": [
    { "required": ["implementationCapabilities"] },
    { "required": ["features"] }
  ],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "primaryDecision": { "type": "string", "minLength": 1 },
    "supportedSchemaVersions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredSections": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredFields": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "optionalSections": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "supportedPageTypes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "features": { "$ref": "#/$defs/capabilities" },
    "implementationCapabilities": { "$ref": "#/$defs/capabilities" },
    "designCapabilities": { "$ref": "#/$defs/capabilities" },
    "ordering": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumReportKitVersion"],
      "properties": {
        "minimumReportKitVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    }
  },
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["multiPage", "scriptFree", "responsive", "printable"],
      "properties": {
        "multiPage": { "type": "boolean" },
        "scriptFree": { "type": "boolean" },
        "responsive": { "type": "boolean" },
        "printable": { "type": "boolean" }
      }
    }
  }
}
