{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reportkit.dev/schema/template-layout-v1.schema.json",
  "title": "ReportKit declarative template layout 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["layoutVersion", "pages"],
  "properties": {
    "layoutVersion": { "const": "1.0" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sections"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.html$" },
          "repeatFor": { "enum": ["groups"] },
          "pathPattern": { "type": "string", "pattern": "^[A-Za-z0-9._/{}/-]+\\.html$" },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["component"],
              "properties": {
                "component": {
                  "enum": [
                    "report-masthead", "overall-status", "freshness-panel",
                    "metric-grid", "trend-visualization", "signal-list",
                    "attention-table", "group-card-grid", "empty-state",
                    "stale-data-warning", "partial-coverage-warning",
                    "validation-warning-banner", "report-footer"
                  ]
                },
                "source": { "enum": ["metrics", "trends", "highlights", "items", "groups"] },
                "variant": { "enum": ["four-up", "three-up", "bars"] },
                "selection": {
                  "enum": [
                    "leadership-attention", "all-open", "overdue",
                    "blocked", "due-in-seven-days"
                  ]
                },
                "linkTo": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
              }
            }
          }
        },
        "oneOf": [
          { "required": ["path"], "not": { "required": ["pathPattern"] } },
          { "required": ["repeatFor", "pathPattern"], "not": { "required": ["path"] } }
        ]
      }
    }
  }
}
