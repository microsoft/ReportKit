{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reportkit.dev/schema/reportkit-v1.schema.json",
  "title": "ReportKit canonical report model 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "report", "provenance"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "report": { "$ref": "#/$defs/report" },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" }, "default": [] },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" }, "default": [] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" }, "default": [] },
    "trends": { "type": "array", "items": { "$ref": "#/$defs/trend" }, "default": [] },
    "highlights": { "type": "array", "items": { "$ref": "#/$defs/highlight" }, "default": [] },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" }, "default": [] },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy", "warning", "critical", "unknown", "not-applicable",
        "blocked", "in-progress", "pending-review", "not-started",
        "complete", "failed", "passed"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 },
        "team": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["displayName"] },
        { "required": ["alias"] },
        { "required": ["team"] }
      ]
    },
    "reportPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "generatedAt", "dataAsOf", "classification"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "dataAsOf": { "type": "string", "format": "date-time" },
        "period": { "$ref": "#/$defs/reportPeriod" },
        "status": { "$ref": "#/$defs/status" },
        "statusLabel": { "type": "string" },
        "statusSummary": { "type": "string" },
        "classification": { "type": "string", "minLength": 1 },
        "outlookMilestones": {
          "type": "array",
          "items": { "$ref": "#/$defs/milestone" }
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": ["number", "string"] },
        "unit": { "type": "string" },
        "direction": { "enum": ["up", "down", "flat"] },
        "assessment": { "enum": ["good", "bad", "neutral", "unknown"] },
        "label": { "type": "string" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value", "unit"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "string"] },
        "unit": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "statusLabel": { "type": "string" },
        "description": { "type": "string" },
        "target": { "type": ["number", "string", "null"] },
        "order": { "type": "integer" },
        "delta": { "$ref": "#/$defs/delta" },
        "link": { "$ref": "#/$defs/link" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "type": "string" },
        "accountableOwner": { "$ref": "#/$defs/owner" },
        "metricIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "itemIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "childGroupIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "managementAction": { "type": "string" },
        "order": { "type": "integer" },
        "page": { "type": "string", "pattern": "^[^\\\\]+\\.html$" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "lifecycle": { "enum": ["open", "closed", "completed", "cancelled", "unknown"] },
        "category": {
          "enum": [
            "action", "risk", "build", "deployment", "incident", "requirement",
            "control", "recovery", "decision", "other"
          ]
        },
        "priority": { "enum": ["critical", "high", "medium", "low", "unknown"] },
        "severity": { "type": "string" },
        "confidence": { "enum": ["confirmed", "likely", "possible", "unknown"] },
        "rootCauseState": { "enum": ["unknown", "investigating", "suspected", "confirmed", "not-applicable"] },
        "evidenceState": { "enum": ["not-required", "missing", "partial", "submitted", "verified", "rejected", "unknown"] },
        "exception": { "$ref": "#/$defs/exception" },
        "readinessGate": { "$ref": "#/$defs/readinessGate" },
        "recoveryMilestones": {
          "type": "array",
          "items": { "$ref": "#/$defs/milestone" }
        },
        "accountableOwner": { "$ref": "#/$defs/owner" },
        "actionOwner": { "$ref": "#/$defs/owner" },
        "dueDate": { "type": ["string", "null"], "format": "date" },
        "eta": { "type": ["string", "null"], "format": "date" },
        "etaHealth": { "enum": ["early", "on-track", "at-risk", "late", "unknown"] },
        "statusText": { "type": "string" },
        "impact": { "type": "string" },
        "nextAction": { "type": "string" },
        "nextActionDate": { "type": ["string", "null"], "format": "date" },
        "blocker": { "type": ["string", "null"] },
        "ageDays": { "type": "integer", "minimum": 0 },
        "groupIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "order": { "type": "integer" }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "targetDate": { "type": ["string", "null"], "format": "date" },
        "completedDate": { "type": ["string", "null"], "format": "date" },
        "summary": { "type": "string" },
        "statusText": { "type": "string" },
        "progressPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "milestoneType": { "type": "string" },
        "owner": { "$ref": "#/$defs/owner" },
        "dependency": { "type": "string" },
        "impact": { "type": "string" },
        "nextAction": { "type": "string" },
        "order": { "type": "integer" }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["requested", "approved", "rejected", "expired", "cancelled", "unknown"] },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    },
    "readinessGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not-started", "in-progress", "passed", "failed", "waived", "unknown"] },
        "decision": { "enum": ["proceed", "hold", "conditional", "undecided"] },
        "summary": { "type": "string" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "value"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "value": { "type": "number" },
        "label": { "type": "string" }
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "unit", "observations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observation" } },
        "order": { "type": "integer" }
      }
    },
    "highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "type": { "enum": ["win", "risk", "change", "decision", "information"] },
        "status": { "$ref": "#/$defs/status" },
        "groupIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "itemIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "order": { "type": "integer" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["internal", "source", "evidence", "documentation", "workflow"] },
        "href": { "type": "string", "minLength": 1 },
        "page": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["href"] },
        { "required": ["page"] }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "recordCount": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "sources", "recordCounts"],
      "properties": {
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "recordCounts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "state"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "state": { "enum": ["complete", "partial", "unavailable", "stale", "unknown"] },
              "summary": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
