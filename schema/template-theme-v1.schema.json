{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reportkit.dev/schema/template-theme-v1.schema.json",
  "title": "ReportKit declarative template theme 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["themeVersion", "name", "tokens"],
  "properties": {
    "themeVersion": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "accent", "canvas", "surface", "fontFamily"],
      "properties": {
        "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "canvas": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "surface": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "fontFamily": { "const": "system" }
      }
    },
    "terminology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": { "type": "string", "minLength": 1, "maxLength": 60 },
        "item": { "type": "string", "minLength": 1, "maxLength": 60 },
        "accountableOwner": { "type": "string", "minLength": 1, "maxLength": 60 },
        "actionOwner": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
    }
  }
}
