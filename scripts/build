#!/usr/bin/env python3
"""Build a deterministic ReportKit static site."""

import argparse
from pathlib import Path

from reportkit_engine import build_site, lexical_absolute_path


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate a deterministic static ReportKit site.")
    parser.add_argument("--template", required=True, help="Template ID.")
    parser.add_argument("--data", required=True, type=Path, help="Canonical ReportKit JSON document.")
    parser.add_argument("--config", required=True, type=Path, help="Rendering configuration.")
    parser.add_argument("--output", type=Path, default=Path("report-site"), help="Output directory.")
    parser.add_argument("--overwrite", action="store_true", help="Replace an existing ReportKit-owned output.")
    args = parser.parse_args()

    root = Path(__file__).resolve().parents[1]
    capability = root / "templates" / args.template / "template.json"
    if not capability.is_file():
        parser.error(f"unknown template '{args.template}'")

    report = build_site(
        args.data.resolve(),
        args.config.resolve(),
        capability,
        lexical_absolute_path(args.output),
        overwrite=args.overwrite,
    )
    print(f"Validation: {report['status']}")
    print(
        f"Errors: {report['summary']['errorCount']}  "
        f"Warnings: {report['summary']['warningCount']}  "
        f"Info: {report['summary']['infoCount']}"
    )
    for issue in report["errors"] + report["warnings"]:
        print(f"{issue['code']}: {issue['message']}")
    return 1 if report["errors"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
