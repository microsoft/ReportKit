#!/usr/bin/env python3
"""Validate a local declarative ReportKit template pack."""

import argparse
import json
from pathlib import Path

from template_pack import validate_pack


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate a local ReportKit declarative template pack.")
    parser.add_argument("template", type=Path, help="Local template folder or ZIP archive.")
    args = parser.parse_args()
    report, pack = validate_pack(args.template.resolve())
    result = dict(report)
    if pack is not None:
        result["template"] = {
            "id": pack["template"]["id"],
            "version": pack["template"]["version"],
            "kind": "declarative",
            "digest": pack["digest"],
        }
    print(json.dumps(result, indent=2, sort_keys=True))
    return 1 if report["errors"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
